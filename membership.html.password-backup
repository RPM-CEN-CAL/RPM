<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seller Membership & Plans | RPM Equipment</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- QRCode.js Library for dynamic QR generation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .help-fab {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 99999;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between antialiased relative">

  <!-- Header Header Layout -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="index.html" class="flex flex-col group">
        <div class="text-2xl font-black tracking-tight text-white flex items-center gap-2">
          <span class="bg-blue-600 text-white px-2 py-0.5 rounded-lg font-mono text-sm">RPM</span>
          <span class="group-hover:text-blue-400 transition-colors">EQUIPMENT</span>
        </div>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-400 tracking-tight">Buy & Sell Equipment</span>
      </a>

      <div class="flex items-center space-x-4">
        <a href="membership.html" class="text-sm font-semibold text-blue-400 hover:text-blue-300 px-4 py-2 border border-blue-500/30 rounded-lg bg-blue-500/10">Sign Up</a>
        <a href="login.html" class="text-sm font-medium text-slate-300 hover:text-white px-3 py-2">Client Portal</a>
      </div>
    </div>
  </header>

  <main class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-12">
    
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">Seller Membership & Plans</h1>
      <p class="text-slate-400 text-sm max-w-xl mx-auto">Select a subscription plan, enter your credentials, and scan the dynamic QR code to pay.</p>
    </div>

    <!-- Membership Tiers Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div id="tier-card-5" onclick="selectTier(5, '1 Active Listing', 'tier-card-5')" class="tier-card bg-slate-800 border-2 border-blue-500 rounded-2xl p-6 text-center space-y-4 cursor-pointer transition-all">
        <div class="text-3xl font-black text-white">$5 <span class="text-xs font-normal text-slate-400">/mo</span></div>
        <div class="text-sm font-semibold text-blue-400">1 Active Listing</div>
        <p class="text-xs text-slate-400">Ideal for single equipment sales.</p>
        <button type="button" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg text-sm">Selected</button>
      </div>

      <div id="tier-card-10" onclick="selectTier(10, '5 Active Listings', 'tier-card-10')" class="tier-card bg-slate-800/80 border-2 border-slate-700 hover:border-blue-500 rounded-2xl p-6 text-center space-y-4 cursor-pointer transition-all">
        <div class="text-3xl font-black text-white">$10 <span class="text-xs font-normal text-slate-400">/mo</span></div>
        <div class="text-sm font-semibold text-blue-400">5 Active Listings</div>
        <p class="text-xs text-slate-400">Great for small fleet liquidation.</p>
        <button type="button" class="w-full bg-slate-700 text-slate-300 font-semibold py-2 rounded-lg text-sm">Select Tier</button>
      </div>

      <div id="tier-card-20" onclick="selectTier(20, '15 Active Listings', 'tier-card-20')" class="tier-card bg-slate-800/80 border-2 border-slate-700 hover:border-blue-500 rounded-2xl p-6 text-center space-y-4 cursor-pointer transition-all">
        <div class="text-3xl font-black text-white">$20 <span class="text-xs font-normal text-slate-400">/mo</span></div>
        <div class="text-sm font-semibold text-blue-400">15 Active Listings</div>
        <p class="text-xs text-slate-400">For active equipment dealers.</p>
        <button type="button" class="w-full bg-slate-700 text-slate-300 font-semibold py-2 rounded-lg text-sm">Select Tier</button>
      </div>

      <div id="tier-card-50" onclick="selectTier(50, 'Unlimited Listings', 'tier-card-50')" class="tier-card bg-slate-800/80 border-2 border-slate-700 hover:border-blue-500 rounded-2xl p-6 text-center space-y-4 cursor-pointer transition-all">
        <div class="text-3xl font-black text-white">$50 <span class="text-xs font-normal text-slate-400">/mo</span></div>
        <div class="text-sm font-semibold text-blue-400">Unlimited Listings</div>
        <p class="text-xs text-slate-400">Enterprise volume & priority placement.</p>
        <button type="button" class="w-full bg-slate-700 text-slate-300 font-semibold py-2 rounded-lg text-sm">Select Tier</button>
      </div>
    </div>

    <!-- Integrated Account Credentials & Direct QR Payment Box -->
    <div class="max-w-xl mx-auto bg-slate-800/90 border border-slate-700 rounded-2xl p-8 space-y-6 shadow-2xl">
      <div class="text-center space-y-1">
        <h2 class="text-2xl font-bold text-white">Create Account & Pay</h2>
        <p id="selected-tier-display" class="text-xs text-blue-400 font-medium">Selected Tier: $5 / mo (1 Active Listing)</p>
      </div>

      <form id="signup-form" onsubmit="handleAccountRegistration(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">EMAIL ADDRESS *</label>
          <input type="email" id="signupEmail" required placeholder="name@company.com" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">CREATE PASSWORD *</label>
          <input type="password" id="signupPassword" required placeholder="••••••••" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500">
        </div>

        <!-- NEW PAYMENT METHOD LAYOUT: Side-by-Side Cards -->
        <div class="border-t border-slate-700/80 pt-4 space-y-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Payment Method</label>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-stretch">
            <!-- Left Card: Cost Breakdown -->
            <div class="bg-slate-900 border border-slate-700 rounded-xl p-5 flex flex-col justify-center space-y-3">
              <div class="flex justify-between items-center text-xs text-slate-400">
                <span>Base Subscription Tier:</span>
                <span id="summary-base" class="font-mono text-slate-200">$5.00</span>
              </div>
              <div class="flex justify-between items-center text-xs text-slate-400">
                <span>Processing Fee (3%):</span>
                <span id="summary-fee" class="font-mono text-slate-200">$0.15</span>
              </div>
              <div class="border-t border-slate-800 pt-3 flex justify-between items-center">
                <span class="text-sm font-bold text-white">Total Due Now:</span>
                <span id="summary-total" class="text-base font-extrabold text-blue-400 font-mono">$5.15</span>
              </div>
            </div>

            <!-- Right Card: 3"x3" Dynamic Mobile Pay QR -->
            <div class="bg-slate-900 border border-slate-700 rounded-xl p-5 flex flex-col items-center justify-center text-center space-y-2">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Mobile Pay QR</span>
              <div id="qrcode" class="p-2 bg-white rounded-lg shadow-md flex items-center justify-center"></div>
              <span id="qrAmountDisplay" class="text-xs font-bold text-blue-400 font-mono">$5.15</span>
            </div>
          </div>
        </div>

        <div class="space-y-3 pt-2">
          <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-700/80 text-[11px] text-slate-400 space-y-1.5 max-h-24 overflow-y-auto">
            <p class="font-semibold text-slate-300">Commercial Marketplace User Agreement:</p>
            <p>By proceeding to checkout, you agree to RPM Equipment's Terms of Service. All listings must accurately represent equipment condition, hours, and specifications.</p>
          </div>

          <label class="flex items-start gap-2.5 cursor-pointer group">
            <input type="checkbox" id="agreeTerms" required class="mt-0.5 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-blue-500">
            <span class="text-xs text-slate-300 group-hover:text-white transition-colors">
              I have read and agree to the <span class="text-blue-400 underline">User Agreement</span> and authorize subscription billing.
            </span>
          </label>
        </div>

        <button type="submit" id="submit-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-6 rounded-lg shadow-lg shadow-blue-600/30 transition-all text-sm flex items-center justify-center gap-2 cursor-pointer">
          <span>Complete Registration & Pay ($<span id="btn-total">5.15</span>)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </form>
    </div>

  </main>

  <!-- Help Floating Action Button -->
  <div class="help-fab">
    <button onclick="openVisitorHelpModal()" aria-label="Open Visitor Equipment & Account Guided Tour" class="bg-amber-400 hover:bg-amber-300 text-slate-950 rounded-full p-4 shadow-[0_10px_35px_rgba(251,191,36,0.45)] flex items-center justify-center gap-3 font-black ring-4 ring-amber-400/50 hover:ring-amber-300 focus:outline-none focus:ring-4 focus:ring-white transition-all transform hover:scale-105 active:scale-95 cursor-pointer">
      <span class="w-10 h-10 bg-slate-950 text-amber-400 rounded-full flex items-center justify-center font-black text-2xl shadow-inner">?</span>
      <span class="text-xs font-black uppercase tracking-widest text-slate-950 pr-2">Need Help? Tour Guide</span>
    </button>
  </div>

  <!-- Help Modal -->
  <div id="visitorHelpModal" class="hidden fixed inset-0 bg-slate-950/85 backdrop-blur-md z-[100000] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="visitorModalTitle">
    <div class="bg-slate-900 border-4 border-amber-400 rounded-3xl max-w-2xl w-full p-6 sm:p-8 text-white shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-6 max-h-[90vh] overflow-y-auto">
      
      <div class="flex justify-between items-center border-b-2 border-slate-800 pb-4">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 bg-amber-400 text-slate-950 rounded-xl flex items-center justify-center font-black text-xl">❓</span>
          <div>
            <h2 id="visitorModalTitle" class="text-xl font-extrabold text-amber-400 tracking-tight">Visitor & Buyer Assistance Guide</h2>
            <p class="text-xs text-slate-300">Step-by-step directions for equipment buyers and prospective seller accounts.</p>
          </div>
        </div>
        <button onclick="closeVisitorHelpModal()" aria-label="Close Help Modal" class="text-slate-400 hover:text-white font-black text-2xl px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors">&times;</button>
      </div>

      <div class="space-y-4 text-xs sm:text-sm">
        <div class="p-4 bg-slate-800/90 rounded-2xl border-l-4 border-amber-400 space-y-1 shadow-md">
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-amber-400 uppercase tracking-wider text-xs">Step 1: Equipment Search & Valuation</span>
            <span class="bg-amber-400/20 text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded-md">Free Visitors</span>
          </div>
          <p class="text-slate-200 leading-relaxed">Browse active machinery listings directly from the Home page. Use the integrated Valuation Calculator to compute market estimates based on age, hours, and condition prior to making seller offers.</p>
        </div>

        <div class="p-4 bg-slate-800/90 rounded-2xl border-l-4 border-blue-500 space-y-1 shadow-md">
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-blue-400 uppercase tracking-wider text-xs">Step 2: Selecting a Membership Tier</span>
            <span class="bg-blue-500/20 text-blue-300 text-[10px] font-bold px-2 py-0.5 rounded-md">Sellers</span>
          </div>
          <p class="text-slate-200 leading-relaxed">Select your desired active listing volume ($5 for 1 listing, $10 for 5, $20 for 15, or $50 for unlimited). Click <strong>"Select Tier"</strong> to highlight your selection.</p>
        </div>

        <div class="p-4 bg-slate-800/90 rounded-2xl border-l-4 border-emerald-500 space-y-1 shadow-md">
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-emerald-400 uppercase tracking-wider text-xs">Step 3: Account Creation & Payment</span>
            <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded-md">Account Setup</span>
          </div>
          <p class="text-slate-200 leading-relaxed">Enter your business email and password, then scan the dynamic mobile QR code directly to submit payment without leaving the card.</p>
        </div>

        <div class="p-4 bg-slate-800/90 rounded-2xl border-l-4 border-purple-500 space-y-1 shadow-md">
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-purple-400 uppercase tracking-wider text-xs">Step 4: Existing Sellers Login</span>
            <span class="bg-purple-500/20 text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded-md">Client Portal</span>
          </div>
          <p class="text-slate-200 leading-relaxed">If you already possess an active paid seller subscription, click <strong>"Client Portal"</strong> in the top header menu to sign into your seller dashboard.</p>
        </div>
      </div>

      <div class="pt-2 border-t border-slate-800 flex justify-end">
        <button onclick="closeVisitorHelpModal()" class="w-full sm:w-auto bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold px-8 py-3 rounded-xl text-xs uppercase tracking-wider transition-all shadow-lg shadow-amber-400/20">
          Close Tour & Continue
        </button>
      </div>
    </div>
  </div>

  <footer class="bg-slate-950 border-t border-slate-800 py-6 text-center text-slate-500 text-xs">
    &copy; RPM Equipment Marketplace. All rights reserved.
  </footer>

  <script>
  const API_BASE = '/api';

  let selectedBasePrice = 5;
  let selectedTierName = '1 Active Listing';
  let qrCodeInstance = null;
  let checkoutUrl = '';

  function selectTier(price, tierName, cardId) {
    selectedBasePrice = price;
    selectedTierName = tierName;
    checkoutUrl = '';

    document.querySelectorAll('.tier-card').forEach(card => {
      card.classList.remove('border-blue-500', 'bg-slate-800');
      card.classList.add('border-slate-700', 'bg-slate-800/80');

      const btn = card.querySelector('button');

      if (btn) {
        btn.className =
          'w-full bg-slate-700 text-slate-300 font-semibold py-2 rounded-lg text-sm';
        btn.innerText = 'Select Tier';
      }
    });

    const activeCard = document.getElementById(cardId);

    if (activeCard) {
      activeCard.classList.remove(
        'border-slate-700',
        'bg-slate-800/80'
      );

      activeCard.classList.add(
        'border-blue-500',
        'bg-slate-800'
      );

      const activeBtn = activeCard.querySelector('button');

      if (activeBtn) {
        activeBtn.className =
          'w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg text-sm';

        activeBtn.innerText = 'Selected';
      }
    }

    const fee = selectedBasePrice * 0.03;
    const total = selectedBasePrice + fee;

    document.getElementById('selected-tier-display').innerText =
      `Selected Tier: $${selectedBasePrice} / mo (${tierName})`;

    document.getElementById('summary-base').innerText =
      `$${selectedBasePrice.toFixed(2)}`;

    document.getElementById('summary-fee').innerText =
      `$${fee.toFixed(2)}`;

    document.getElementById('summary-total').innerText =
      `$${total.toFixed(2)}`;

    document.getElementById('btn-total').innerText =
      total.toFixed(2);

    document.getElementById('qrAmountDisplay').innerText =
      `$${total.toFixed(2)}`;

    updateQRCode(window.location.href);
  }

  function updateQRCode(payloadUrl) {
    const qrContainer = document.getElementById('qrcode');

    if (!qrContainer || typeof QRCode === 'undefined') {
      return;
    }

    qrContainer.innerHTML = '';

    qrCodeInstance = new QRCode(qrContainer, {
      text: payloadUrl,
      width: 100,
      height: 100,
      colorDark: '#000000',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.H
    });
  }

  async function readJsonResponse(response) {
    const contentType = response.headers.get('content-type') || '';

    if (!contentType.includes('application/json')) {
      throw new Error(
        `Server returned an invalid response (${response.status}).`
      );
    }

    return response.json();
  }

  async function handleAccountRegistration(event) {
    event.preventDefault();

    const submitBtn = document.getElementById('submit-btn');
    const agreeTerms = document.getElementById('agreeTerms');

    if (!agreeTerms || !agreeTerms.checked) {
      alert(
        'Please review and accept the User Agreement to proceed.'
      );
      return;
    }

    const email = document
      .getElementById('signupEmail')
      .value
      .trim()
      .toLowerCase();

    const password =
      document.getElementById('signupPassword').value;

    if (!email || !password) {
      alert('Please enter a valid email and password.');
      return;
    }

    if (password.length < 8) {
      alert('Password must contain at least 8 characters.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-60', 'cursor-not-allowed');
    submitBtn.innerText = 'Creating secure checkout...';

    try {
      const registrationResponse = await fetch(
        `${API_BASE}/register`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email,
            password,
            plan: selectedTierName
          })
        }
      );

      const registrationData =
        await readJsonResponse(registrationResponse);

      if (!registrationResponse.ok || !registrationData.success) {
        throw new Error(
          registrationData.message ||
          'Account registration failed.'
        );
      }

      const checkoutResponse = await fetch(
        `${API_BASE}/create-square-checkout`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email,
            basePrice: selectedBasePrice,
            tierName: selectedTierName
          })
        }
      );

      const checkoutData =
        await readJsonResponse(checkoutResponse);

      if (!checkoutResponse.ok || !checkoutData.success) {
        throw new Error(
          checkoutData.error ||
          'Square checkout could not be created.'
        );
      }

      if (checkoutData.isVip) {
        alert('VIP access granted. Your account is ready.');

        window.location.href = 'seller-dashboard.html';
        return;
      }

      checkoutUrl =
        checkoutData.checkoutUrl || checkoutData.url || '';

      if (!checkoutUrl) {
        throw new Error(
          'Square did not return a checkout address.'
        );
      }

      updateQRCode(checkoutUrl);

alert(
  'Account created successfully. Scan the QR code below to complete payment.'
);

document.getElementById('qrcode').scrollIntoView({
  behavior: 'smooth',
  block: 'center'
});

return;
    } catch (error) {
      console.error('Registration/checkout error:', error);

      alert(
        error.message ||
        'Registration or checkout could not be completed.'
      );
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove(
        'opacity-60',
        'cursor-not-allowed'
      );

      submitBtn.innerHTML =
        `<span>Complete Registration & Pay ($<span id="btn-total">${(selectedBasePrice * 1.03).toFixed(2)}</span>)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor"
             viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3">
          </path>
        </svg>`;
    }
  }

  function openVisitorHelpModal() {
    document
      .getElementById('visitorHelpModal')
      .classList.remove('hidden');
  }

  function closeVisitorHelpModal() {
    document
      .getElementById('visitorHelpModal')
      .classList.add('hidden');
  }

  window.addEventListener('DOMContentLoaded', () => {
    selectTier(5, '1 Active Listing', 'tier-card-5');
  });
</script>
</body>
</html>